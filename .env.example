# Copy the values you need into your host's environment. The app does not load this file automatically.
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
# Optional override; the default offline model folder is <DATA_DIR>/models.
# SYMBI_MODEL_ROOT=./data/models
PUBLIC_URL=http://127.0.0.1:8787

# Required when the server is reachable from another machine. Generate your own long random value.
SYMBIKNOW_ACCESS_TOKEN=replace-with-a-long-random-token

# Optional: configure these in Settings instead if you prefer.
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
