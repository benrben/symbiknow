# Secret hosted Jev token; obtain from https://console.typesafe.ai
TYPESAFE_API_KEY=
SYMBIKNOW_DATA_DIR=./data
SYMBIKNOW_STORAGE_ONLY=0
SYMBIKNOW_EMBEDDING_DEVICE=auto
HF_HOME=./data/models
# Optional limits and runtime overrides
TYPESAFE_DEFAULT_MODEL=jev-1.14.0
SYMBIKNOW_MAX_CHUNK_BYTES=262144
SYMBIKNOW_MAX_FILE_BYTES=268435456
SYMBIKNOW_MAX_PAGES=1000
SYMBIKNOW_CONVERSION_TIMEOUT=300

# Memory/resource controls. Use the regular PyTorch runtime.
SYMBIKNOW_EMBEDDING_RUNTIME=torch
# Tested on Apple Silicon MPS. Use none for CPU/CUDA or an unapproved existing index.
SYMBIKNOW_TORCH_QUANTIZATION=int8
# SYMBIKNOW_MODEL_IDLE_SECONDS=60
# SYMBIKNOW_TRANSFER_CACHE_BYTES=1073741824
# SYMBIKNOW_TRANSFER_CACHE_SECONDS=3600
# SYMBIKNOW_PREVIEW_CACHE_BYTES=268435456
# SYMBIKNOW_PREVIEW_CACHE_SECONDS=604800
