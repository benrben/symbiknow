const library = doc('Book return desk', '## Check\nScan the returned book barcode and check for damaged pages.\n\n## Shelf\nPut undamaged books on the shelving cart in call-number order.');
const bicycle = doc('Bicycle tyre inspection', '## Pressure\nRead the sidewall pressure range before inflating each tyre.\n\n## Wear\nInspect the tread and replace tyres with visible fabric or deep cuts.');
const bases = [bakery, garden, library, bicycle];
const renamed = ['Morning bread counter', 'Tomato bed care', 'Returned books workflow', 'Cycle wheel safety'];
export const heldoutDuplicates: HeldoutDuplicate[] = [
  ...bases.map((source, index) => ({ name: `copy-${index}`, source, target: { title: renamed[index], body: source.body.replace(/^# .+/, `# ${renamed[index]}`) }, truth: 'copy' as const })),
  ...bases.map((source, index) => ({ name: `older-${index}`, source, target: doc(source.title + ' updated', source.body.replace(/^# .+\n\n/, '') + '\n\n## Closing check\nThe closing supervisor signs the completed checklist and stores it in the blue office folder.'), truth: 'older_version' as const })),
