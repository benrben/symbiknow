  { name: 'different-greenhouse-maintenance', source: garden, target: doc('Greenhouse roof maintenance', '## Glass\nCheck the roof panes for cracks once per quarter.\n\n## Repairs\nClose the affected aisle while the contractor replaces broken glass.'), truth: 'distinct' },
