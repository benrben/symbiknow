// Frozen invented cases from domains outside Project Atlas. No customer or workspace data.
export type HeldoutDocument = { title: string; body: string };
export type HeldoutDuplicate = { name: string; source: HeldoutDocument; target: HeldoutDocument; truth: 'copy' | 'older_version' | 'distinct' };
export type HeldoutLink = { name: string; source: HeldoutDocument; target: HeldoutDocument; truth: boolean };
const doc = (title: string, body: string): HeldoutDocument => ({ title, body: `# ${title}\n\n${body}` });
const bakery = doc('Bakery opening', '## Stock\nCount sourdough loaves and record the number on the counter sheet.\n\n## Setup\nPlace clean tongs beside the bread trays before opening the shop.');
